!supabase/seed.sql
# Seed de usuarios de desarrollo: lleva la contraseña local (npm run seed:dev)
supabase/seeds/local/
!supabase/tests/**/*.sql

# Hojas de cálculo y datos tabulares
*.xlsx
*.xls
*.csv

# Sistema operativo
.DS_Store

# PDF generados (los ejemplos viven fuera del repositorio)
*.pdf

# Capturas y registros de Playwright MCP
.playwright-mcp/

# Resultados de Playwright (pruebas en el navegador)
playwright-report/
test-results/
