# Variables de entorno y secretos
.env*

# Dependencias y build
node_modules/
.next/
/out/
/build
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts
*.pem
npm-debug.log*

# Configuración local de Claude Code
.claude/settings.local.json

# Datos reales y respaldos
datos-reales/
backups/

# Respaldos SQL (las migraciones de Supabase sí se versionan)
*.sql
